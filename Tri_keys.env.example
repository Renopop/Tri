# =============================================================================
#  Tri_keys.env — VOS CLÉS API (fichier dédié aux secrets)
# =============================================================================
#
#  1. Copiez ce fichier sous le nom « Tri_keys.env » (même dossier que tri_llm.py).
#  2. Renseignez les DEUX clés : la passerelle LiteLLM (LiteMaaS) délivre une
#     clé DISTINCTE par modèle — récupérez-les sur la page « Clés API ».
#
#  Ce fichier n'est JAMAIS versionné (.gitignore). Une variable déjà définie
#  dans l'environnement n'est pas écrasée. Chemin forcé : TRI_KEYS_FILE.
#  Format : KEY=VALUE, une par ligne, « # » = commentaire.
# =============================================================================

# Clé du modèle mistral-small-4 (colonne H « LLM Mistral »).
# Les clés COMPAREDB_LLM_KEY / RIVAGE_SYNTH_KEY sont acceptées en repli.
TRI_MISTRAL_KEY=collez-la-cle-mistral-small-ici

# Clé du modèle gemma-4 (colonne I « LLM Gemma »).
TRI_GEMMA_KEY=collez-la-cle-gemma-ici

# --- Options (facultatives) ---------------------------------------------------
# Passerelle (défaut : https://litellm.dassault-aviation.pro/v1) :
# TRI_API_BASE=https://litellm.dassault-aviation.pro/v1
# Noms des modèles tels que la passerelle les connaît :
# TRI_MISTRAL_MODEL=mistral-small-4
# TRI_GEMMA_MODEL=gemma-4
# Débit autorisé par clé (requêtes par minute, voir « Limite RPM » sur LiteMaaS) :
# TRI_MISTRAL_RPM=20
# TRI_GEMMA_RPM=20
# Feuille à traiter (défaut : la première) :
# TRI_SHEET=ACES_FT_classified_for_Gemma

# --- TLS interne, si erreur CERTIFICATE_VERIFY_FAILED — au choix --------------
# 1) Recommandé — bundle CA interne (.pem) :
# DALLEM_CA_BUNDLE=C:\chemin\vers\ca-dassault.pem
# 2) Repli rapide (réseau interne maîtrisé) :
# DALLEM_VERIFY_SSL=false
